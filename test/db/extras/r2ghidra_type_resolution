NAME=unresolved declared arguments and returns refuse instead of substituting storage
FILE=hex://89f8c3
ARGS=-a x86 -b 64 -e log.level=0
CMDS=<<EOF
af
e r2ghidra.lang=x86:LE:64:default:gcc
"afs int32_t declared(int32_t value)"
afc amd64
tk func.declared.arg.0=Missing,value
pdgj
tk func.declared.arg.0=int32_t,value
tk func.declared.ret=Missing
pdgj
tk func.declared.ret=int32_t
tk func.declared.arg.0=uint8_t[0],value
pdgj
tk func.declared.arg.0=int32_t,value
pdg~declared(
EOF
EXPECT=<<EOF
{"errors":["Ghidra Decompiler Error: Failed to match arg type Missing for function declared: Unable to resolve type 'Missing'"]}
{"errors":["Ghidra Decompiler Error: Failed to match return type Missing for function declared: Unable to resolve type 'Missing'"]}
{"errors":["Ghidra Decompiler Error: Failed to match arg type uint8_t[0] for function declared: Invalid or oversized array type"]}
int32_t declared(int32_t value)
EOF
RUN

