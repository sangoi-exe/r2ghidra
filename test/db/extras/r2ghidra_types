NAME=address-linked typed prototype wins over a name match and survives rename
FILE=malloc://128
ARGS=-a x86 -b 32 -m 0x1000 -e log.level=0
CMDS=<<EOF
wx c3
af+ 0x1000 original_name
afb+ 0x1000 0x1000 1
afc cdecl
e r2ghidra.lang=x86:LE:32:default:gcc
"td typedef unsigned short WORD;"
"td struct FarAddress16 { WORD offset; WORD selector; };"
tk struct.FarAddress16.selector=WORD,2,0
"td int original_name(int wrong);"
"td void linked_move(FarAddress16 source, FarAddress16 destination, WORD byte_count);"
tl linked_move = 0x1000
afs
pdgd~prototype model=
pdgd~addr space="stack"
pdg~original_name(
afn renamed_move
afs
pdgd~prototype model=
pdgd~addr space="stack"
pdg~renamed_move(
EOF
EXPECT=<<EOF
void original_name (FarAddress16 source, FarAddress16 destination, WORD byte_count);
            <prototype model="__cdecl" extrapop="4" modellock="true">
                    <addr space="stack" offset="0xc"/>
                    <addr space="stack" offset="0x8"/>
                    <addr space="stack" offset="0x4"/>
void original_name(FarAddress16 source,FarAddress16 destination,WORD byte_count)
void renamed_move (FarAddress16 source, FarAddress16 destination, WORD byte_count);
            <prototype model="__cdecl" extrapop="4" modellock="true">
                    <addr space="stack" offset="0xc"/>
                    <addr space="stack" offset="0x8"/>
                    <addr space="stack" offset="0x4"/>
void renamed_move(FarAddress16 source,FarAddress16 destination,WORD byte_count)
EOF
RUN

